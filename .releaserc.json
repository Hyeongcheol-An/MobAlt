{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run dist && scripts/update-cask.sh ${nextRelease.version} Casks",
        "successCmd": "scripts/update-cask.sh ${nextRelease.version} Casks"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "package-lock.json",
          "CHANGELOG.md",
          "Casks/mobalt.rb"
        ],
        "message": "chore(release): v${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/*-arm64.dmg",
            "label": "MobAlt ${nextRelease.version} \u2014 macOS Apple Silicon (arm64) DMG"
          },
          {
            "path": "dist/*-x64.dmg",
            "label": "MobAlt ${nextRelease.version} \u2014 macOS Intel (x64) DMG"
          },
          {
            "path": "dist/*-arm64.zip",
            "label": "MobAlt ${nextRelease.version} \u2014 macOS Apple Silicon (arm64) zip"
          },
          {
            "path": "dist/*-x64.zip",
            "label": "MobAlt ${nextRelease.version} \u2014 macOS Intel (x64) zip"
          },
          {
            "path": "dist/latest-mac.yml",
            "label": "latest-mac.yml (auto-update manifest)"
          }
        ]
      }
    ]
  ]
}
