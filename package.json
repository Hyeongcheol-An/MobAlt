{
  "name": "mobalt",
  "productName": "MobAlt",
  "version": "0.10.1",
  "description": "MobaXterm alternative for macOS - tabbed SSH/SFTP/local terminal with session manager, tunnels, MultiExec, X11 forwarding",
  "main": "src/main/main.js",
  "author": "Hyeongcheol An (https://github.com/Hyeongcheol-An)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac",
    "test:sshd": "node test/start-sshd.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "release": "semantic-release",
    "assets": "bash scripts/make-assets.sh",
    "install:local": "bash scripts/install-local.sh"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "basic-ftp": "^6.2.4",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electron/rebuild": "^4.2.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "semantic-release": "^24.2.9"
  },
  "build": {
    "appId": "io.github.hyeongcheol-an.mobalt",
    "productName": "MobAlt",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@serialport/bindings-cpp/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "minimumSystemVersion": "13.0"
    },
    "publish": {
      "provider": "github",
      "owner": "Hyeongcheol-An",
      "repo": "MobAlt"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 110,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 450,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "resetAdHocDarwinSignature": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hyeongcheol-An/MobAlt.git"
  },
  "homepage": "https://github.com/Hyeongcheol-An/MobAlt#readme",
  "bugs": {
    "url": "https://github.com/Hyeongcheol-An/MobAlt/issues"
  }
}
